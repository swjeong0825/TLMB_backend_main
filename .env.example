DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tennis_league

# --- Rate limiting (slowapi, in-memory) ---
# RATELIMIT_ENABLED=true
# RATELIMIT_DEFAULT=120/minute
# RATELIMIT_HEADERS=false

# --- Player-edit window for match score (seconds) ---
# Non-admin (no X-Host-Token) match-score edits are accepted only while
# the match was recorded within the last N seconds. Admins always bypass.
# PLAYER_SCORE_EDIT_WINDOW_SECONDS=3600
